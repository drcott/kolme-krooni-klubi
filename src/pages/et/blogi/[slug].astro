---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import ArticleSisu from '../../../components/ArticleSisu.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('blogi', ({ data }) => data.lang === 'et');
  return posts.map(post => ({
    params: { slug: post.data.slug },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);
---

<BaseLayout title={post.data.title} lang="et">
  <ArticleSisu />

  <article>
    <div class="artikkel-päis">
      <a href="/et/blogi/" class="tagasi">← Kõik postitused</a>
      <h1>{post.data.title}</h1>
      <div class="meta">
        {post.data.date && <span class="kuupaev">{post.data.date}</span>}
        {post.data.author && <span class="autor"> · {post.data.author}</span>}
      </div>
    </div>

    <div class="artikkel-sisu">
      <Content />
    </div>
  </article>
</BaseLayout>

<style>
.artikkel-päis {
  padding-bottom: 20px;
  border-bottom: 2px solid var(--piir);
  margin-bottom: 32px;
}
.tagasi {
  font-family: 'Cinzel', serif;
  font-size: 0.75rem;
  letter-spacing: 0.08em;
  color: var(--kuld);
  text-decoration: none;
  text-transform: uppercase;
  display: block;
  margin-bottom: 12px;
}
.tagasi:hover { text-decoration: underline; }
h1 {
  font-family: 'Cinzel', serif;
  font-size: 2rem;
  font-weight: 600;
  color: var(--pruun);
  line-height: 1.25;
  letter-spacing: 0.02em;
}
.meta {
  margin-top: 10px;
  font-size: 0.9rem;
  color: var(--tekst-hele);
  font-style: italic;
}
.kuupaev { color: var(--kuld); font-style: normal; font-family: 'Cinzel', serif; font-size: 0.82rem; }
</style>
